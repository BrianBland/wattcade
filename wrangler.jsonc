{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wattcade",
  "compatibility_date": "2026-10-01",
  // Static site: no Worker script. Cloudflare serves ./dist directly.
  "assets": {
    "directory": "./dist"
  },
  // Required for PR preview URLs. Specifying `routes` otherwise defaults workers_dev to off.
  "workers_dev": true,
  "preview_urls": true,
  // Opts in to `wrangler preview` (per-PR Previews, see .github/workflows/preview.yml).
  "previews": {},
  // Cloudflare creates the DNS record and certificate; brianb.land must be a zone on this account.
  "routes": [{ "pattern": "wattcade.brianb.land", "custom_domain": true }]
}
